  "1": {
   "name": "Krybor",
   "genre": "battle punk metal",
   "keyscale": "E minor",
   "summary": "E5-power-chord downstroke riff with a G-A push into every second bar; progression E | E | C | D | E | E | A-G | B; shouted-melody lead hook B-B-A-G-E.",
   "bpm": 169.9993,
   "barSamples": 67765
  },
  "2": {
   "name": "Ringfall",
   "genre": "melodic power metal",
   "keyscale": "D major",
   "summary": "Syncopated open-chord riff over D | F#m | G | A | Bm | G | Em | A; soaring lead hook A-F#-A, C#-B, rising to F#5 in the second half.",
   "bpm": 160.0,
   "barSamples": 72000
  },
  "3": {
   "name": "Ember Moon",
   "genre": "heavy galloping battle metal",
   "keyscale": "E minor",
   "summary": "Galloping E pedal riff (eighth + two sixteenths) with a Phrygian F; E | E | C-D | E | E | E | F-G | A-B; twin-guitar hook E-F#-G-B in thirds.",
   "bpm": 180.0,
   "barSamples": 64000
  },
  "4": {
   "name": "The Hollow",
   "genre": "epic doom-battle metal",
   "keyscale": "C minor",
   "summary": "Slow drop-C riff C...Eb | Gb-F-C | Eb-Db | C...B, with the Gb tritone as its dread; half-time drums; tolling bell/lead motif C-G-Ab-G, Eb-D-C.",
   "bpm": 150.0,
   "barSamples": 76800
  },
  "5": {
   "name": "The Carrier",
   "genre": "blackened battle and death metal",
   "keyscale": "F minor",
   "summary": "F | F-Gb-E crawl answered by a low B tritone stab, Db-C, a chromatic Db-D-Eb-E climb and a final F-B stab; tremolo-picked and blast-beaten in the later forms.",
   "bpm": 189.9987,
   "barSamples": 60632
  }
 }
