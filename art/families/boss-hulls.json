{
 "schema": "demon-attack.boss-hulls/v1",
 "name": "boss-hulls",
 "notes": "The composable boss grammar (openspec/changes/boss-grandeur design 7, boss-hero-assets design 4). Every value is an input to tools/boss_rig/build.py (bpy). Units are arena units. Ship frame: x = screen right, y = aft (the bow points -y, toward the player and the camera), z = up. Face frame [ax, ay, n]: the plane through the carrier centre that faces the hero camera (pitch 45, yaw 0); ax, ay are arena units on screen in the hero view and n is the distance toward the camera. Functional features (core maw, bays, turrets, eyes) sit on that plane, so they stay on the simulation windows at every pitch (to second order) and every swerve (the swerve turns the hull about the hero view's screen-up axis: a banked turn of ~8.5 deg heading plus ~8.5 deg roll at 12 deg). Prims: box {size, taper:[tx,ty], skew:[dx,dy]}, loft {axis y|z, sections [at, w, d, c, ox, oz]}, cyl {r, r2, len, seg}, ell {radii, seg}, horn {pts, radii}, prism {poly, n0, n1} (face frame: extruded along n; ship frame: poly in (y,z) extruded along x by n0..n1), web {pts} (membrane surface). Every prim has at, rot (deg, XYZ, applied in its frame), tag (material class) and optional mirror (adds the x-mirrored copy). Module-level mirror: the hull places the module and its x-mirror as two modules (L, R).",
 "views": {"pitch": [38, 45, 52], "yaw": [-12, 0, 12], "hero": [45, 0],
           "swerve_axis": "hero screen-up, ship frame (0, 0.7071, 0.7071)"},
 "anchors": {
  "source": "lib/game/boss_atlas.dart BossAtlas (simulation geometry); gate +-3 units in every view",
  "core": [0, 25, 32, 22], "bay": [46, 21, 22, 16], "turret": [28, 36],
  "solid_body": {"half_width": 78, "top": -25, "bottom": 43, "inset": 3},
  "tolerance": 3.0
 },
 "materials": {
  "hull":     {"clay": 0.55, "id_note": "armoured stone hull"},
  "plate":    {"clay": 0.66, "stage_off": 2, "id_note": "armour plates: torn away from S2"},
  "rib":      {"clay": 0.40, "id_note": "ribs under the plates, exposed from S2"},
  "bone":     {"clay": 0.86},
  "membrane": {"clay": 0.36},
  "metal":    {"clay": 0.48},
  "dark":     {"clay": 0.0, "hint": "dark", "id_note": "maw and bay mouths: hint, near black in clay, far in depth"},
  "eye":      {"clay": 1.00, "hint": "bright", "id_note": "eyes: hint, white in clay and depth"},
  "light":    {"clay": 1.00, "hint": "bright", "id_note": "lit windows and nozzle glow"}
 },
 "palettes": {
  "notes": "Hull-family ramps: the Host stone and violet slag of the ground army, darkened; bone; the Brood's ember lights; the cyan force-shield language shared with alien-insignia (shield overlays only, never baked into the hull).",
  "ramps": {
   "stone":   ["#14111A", "#221D2A", "#322A3C", "#463C52", "#5E526B", "#7A6C86"],
   "slag":    ["#1C0E28", "#311845", "#4A2766", "#683C88", "#8C5EAC"],
   "bone":    ["#4A3A2E", "#9A8466", "#D8C69A", "#FFF3D6"],
   "ember":   ["#3A0A0C", "#7A1410", "#B8260F", "#E8501A", "#FF8A2A", "#FFC85A", "#FFF0B8"],
   "shield":  ["#0B3A4A", "#1C7C90", "#3CC8D8", "#A8F4FF"],
   "ink":     ["#0A0716"]
  },
  "per_hull": {
   "frigate":       {"lead": "stone", "accent": "slag"},
   "cruiser":       {"lead": "slag", "accent": "stone"},
   "battlecruiser": {"lead": "stone", "accent": "ember"},
   "battleship":    {"lead": "stone", "accent": "slag"},
   "dreadnought":   {"lead": "stone", "accent": "ember"}
  }
 },
