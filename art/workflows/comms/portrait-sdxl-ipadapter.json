{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "checkpoint"},
        "inputs": {"ckpt_name": "sdxl-full/sd_xl_base_1.0.safetensors"}},
  "2": {"class_type": "LoraLoader", "_meta": {"title": "pixel-art-xl"},
        "inputs": {"model": ["1", 0], "clip": ["1", 1], "lora_name": "pixel-art-xl.safetensors",
                   "strength_model": 1.0, "strength_clip": 1.0}},
  "10": {"class_type": "IPAdapterModelLoader", "_meta": {"title": "ip-adapter-plus"},
         "inputs": {"ipadapter_file": "ip-adapter-plus_sdxl_vit-h.safetensors"}},
  "11": {"class_type": "CLIPVisionLoader", "_meta": {"title": "clip-vision-h"},
         "inputs": {"clip_name": "model.safetensors"}},
  "12": {"class_type": "LoadImage", "_meta": {"title": "style reference"},
         "inputs": {"image": "$style"}},
  "13": {"class_type": "IPAdapterAdvanced", "_meta": {"title": "style transfer"},
         "inputs": {"model": ["2", 0], "ipadapter": ["10", 0], "image": ["12", 0], "clip_vision": ["11", 0],
                    "weight": 0.55, "weight_type": "style transfer", "combine_embeds": "concat",
                    "start_at": 0.0, "end_at": 0.85, "embeds_scaling": "V only"}},
  "3": {"class_type": "CLIPTextEncode", "_meta": {"title": "$prompt"},
        "inputs": {"clip": ["2", 1], "text": "pixel art character portrait, head and shoulders, facing viewer, flat solid grey background"}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "$negative_prompt"},
        "inputs": {"clip": ["2", 1], "text": "text, watermark, logo, blurry, photo, 3d render"}},
  "5": {"class_type": "EmptyLatentImage", "_meta": {"title": "canvas"},
        "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "6": {"class_type": "KSampler", "_meta": {"title": "$seed"},
        "inputs": {"model": ["13", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["5", 0],
                   "seed": 1, "steps": 26, "cfg": 7.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0}},
  "7": {"class_type": "VAEDecode", "_meta": {"title": "decode"},
        "inputs": {"samples": ["6", 0], "vae": ["1", 2]}},
  "8": {"class_type": "SaveImage", "_meta": {"title": "save"},
        "inputs": {"images": ["7", 0], "filename_prefix": "comms/keyframe-ip"}}
}
