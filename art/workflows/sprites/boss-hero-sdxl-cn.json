{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "sdxl-base"},
        "inputs": {"ckpt_name": "sdxl-full/sd_xl_base_1.0.safetensors"}},
  "10": {"class_type": "IPAdapterModelLoader", "_meta": {"title": "ip-adapter-plus"},
         "inputs": {"ipadapter_file": "ip-adapter-plus_sdxl_vit-h.safetensors"}},
  "11": {"class_type": "CLIPVisionLoader", "_meta": {"title": "clip-vision-h"},
         "inputs": {"clip_name": "model.safetensors"}},
  "12": {"class_type": "LoadImage", "_meta": {"title": "identity reference (today's atlas frame)"},
         "inputs": {"image": "$reference"}},
  "13": {"class_type": "IPAdapterAdvanced", "_meta": {"title": "identity from the reference"},
         "inputs": {"model": ["1", 0], "ipadapter": ["10", 0], "image": ["12", 0], "clip_vision": ["11", 0],
                    "weight": 0.6, "weight_type": "linear", "combine_embeds": "concat",
                    "start_at": 0.0, "end_at": 0.9, "embeds_scaling": "V only"}},
  "20": {"class_type": "LoadImage", "_meta": {"title": "rig depth at the hero view (hints drawn in)"},
         "inputs": {"image": "$control"}},
  "21": {"class_type": "ImageScaleToTotalPixels", "_meta": {"title": "1mp"},
         "inputs": {"image": ["20", 0], "upscale_method": "bilinear", "megapixels": 1.0, "resolution_steps": 8}},
  "22": {"class_type": "ControlNetLoader", "_meta": {"title": "controlnet-union-promax"},
         "inputs": {"control_net_name": "diffusion_pytorch_model_promax.safetensors"}},
  "23": {"class_type": "SetUnionControlNetType", "_meta": {"title": "depth"},
         "inputs": {"control_net": ["22", 0], "type": "depth"}},
  "3": {"class_type": "CLIPTextEncode", "_meta": {"title": "$prompt"},
        "inputs": {"clip": ["1", 1], "text": "game sprite of a monstrous demonic gargoyle warship, seen from above and in front, flat green background"}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "$negative_prompt"},
        "inputs": {"clip": ["1", 1], "text": "text, watermark, logo, blurry, photo"}},
  "24": {"class_type": "ControlNetApplyAdvanced", "_meta": {"title": "apply depth"},
         "inputs": {"positive": ["3", 0], "negative": ["4", 0], "control_net": ["23", 0], "image": ["21", 0],
                    "strength": 0.85, "start_percent": 0.0, "end_percent": 0.85}},
  "25": {"class_type": "VAEEncode", "_meta": {"title": "canvas from the control size"},
         "inputs": {"pixels": ["21", 0], "vae": ["1", 2]}},
  "6": {"class_type": "KSampler", "_meta": {"title": "$seed"},
        "inputs": {"model": ["13", 0], "positive": ["24", 0], "negative": ["24", 1], "latent_image": ["25", 0],
                   "seed": 910000, "steps": 28, "cfg": 6.5, "sampler_name": "dpmpp_2m", "scheduler": "karras",
                   "denoise": 1.0}},
  "7": {"class_type": "VAEDecode", "_meta": {"title": "decode"},
        "inputs": {"samples": ["6", 0], "vae": ["1", 2]}},
  "8": {"class_type": "SaveImage", "_meta": {"title": "save"},
        "inputs": {"images": ["7", 0], "filename_prefix": "boss/hero-sdxl-cn"}}
}
