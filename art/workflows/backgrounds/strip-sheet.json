{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "checkpoint"},
        "inputs": {"ckpt_name": "sdxl-full/sd_xl_base_1.0.safetensors"}},
  "2": {"class_type": "LoraLoader", "_meta": {"title": "pixel-art-xl"},
        "inputs": {"model": ["1", 0], "clip": ["1", 1], "lora_name": "pixel-art-xl.safetensors",
                   "strength_model": 1.0, "strength_clip": 1.0}},
  "3": {"class_type": "CLIPTextEncode", "_meta": {"title": "$prompt"},
        "inputs": {"clip": ["2", 1], "text": "pixel art terrain"}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "$negative_prompt"},
        "inputs": {"clip": ["2", 1], "text": "text, watermark"}},
  "10": {"class_type": "LoadImage", "_meta": {"title": "layout"},
         "inputs": {"image": "$init_image"}},
  "11": {"class_type": "VAEEncode", "_meta": {"title": "encode layout"},
         "inputs": {"pixels": ["10", 0], "vae": ["1", 2]}},
  "12": {"class_type": "KSampler", "_meta": {"title": "$strength"},
         "inputs": {"model": ["2", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["11", 0],
                    "seed": 1, "steps": 30, "cfg": 6.5, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.72}},
  "13": {"class_type": "VAEDecode", "_meta": {"title": "decode pass 1"},
         "inputs": {"samples": ["12", 0], "vae": ["1", 2]}},
  "14": {"class_type": "ImageCrop", "_meta": {"title": "top half"},
         "inputs": {"image": ["13", 0], "width": 1536, "height": 768, "x": 0, "y": 0}},
  "15": {"class_type": "ImageCrop", "_meta": {"title": "bottom half"},
         "inputs": {"image": ["13", 0], "width": 1536, "height": 768, "x": 0, "y": 768}},
  "16": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll: bottom to top"},
         "inputs": {"destination": ["13", 0], "source": ["15", 0], "x": 0, "y": 0, "resize_source": false}},
  "17": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll: top to bottom"},
         "inputs": {"destination": ["16", 0], "source": ["14", 0], "x": 0, "y": 768, "resize_source": false}},
  "18": {"class_type": "LoadImage", "_meta": {"title": "seam band mask"},
         "inputs": {"image": "$mask"}},
  "19": {"class_type": "ImageToMask", "_meta": {"title": "seam mask"},
         "inputs": {"image": ["18", 0], "channel": "red"}},
  "20": {"class_type": "VAEEncode", "_meta": {"title": "encode rolled"},
         "inputs": {"pixels": ["17", 0], "vae": ["1", 2]}},
  "21": {"class_type": "SetLatentNoiseMask", "_meta": {"title": "seam only"},
         "inputs": {"samples": ["20", 0], "mask": ["19", 0]}},
  "22": {"class_type": "KSampler", "_meta": {"title": "seam repaint"},
         "inputs": {"model": ["2", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["21", 0],
                    "seed": 2, "steps": 30, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.62}},
  "23": {"class_type": "VAEDecode", "_meta": {"title": "decode seamless"},
         "inputs": {"samples": ["22", 0], "vae": ["1", 2]}},
  "24": {"class_type": "SaveImage", "_meta": {"title": "save seamless (rolled by half)"},
         "inputs": {"images": ["23", 0], "filename_prefix": "flyover/strip-seamless"}}
}
