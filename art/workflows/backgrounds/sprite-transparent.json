{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "checkpoint"},
        "inputs": {"ckpt_name": "sdxl-full/sd_xl_base_1.0.safetensors"}},
  "2": {"class_type": "LoraLoader", "_meta": {"title": "pixel-art-xl"},
        "inputs": {"model": ["1", 0], "clip": ["1", 1], "lora_name": "pixel-art-xl.safetensors",
                   "strength_model": 0.9, "strength_clip": 0.9}},
  "3": {"class_type": "LayeredDiffusionApply", "_meta": {"title": "layerdiffuse transparent"},
        "inputs": {"model": ["2", 0], "config": "SDXL, Conv Injection", "weight": 1.0}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "$prompt"},
        "inputs": {"clip": ["2", 1], "text": "pixel art game sprite"}},
  "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "$negative_prompt"},
        "inputs": {"clip": ["2", 1], "text": "text, watermark, logo, signature, blurry, photo, 3d render, frame, border, multiple views, character sheet"}},
  "6": {"class_type": "EmptyLatentImage", "_meta": {"title": "canvas"},
        "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "7": {"class_type": "KSampler", "_meta": {"title": "$seed"},
        "inputs": {"model": ["3", 0], "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["6", 0],
                   "seed": 1, "steps": 28, "cfg": 6.5, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 1.0}},
  "8": {"class_type": "VAEDecode", "_meta": {"title": "decode"},
        "inputs": {"samples": ["7", 0], "vae": ["1", 2]}},
  "9": {"class_type": "LayeredDiffusionDecode", "_meta": {"title": "transparent decode"},
        "inputs": {"samples": ["7", 0], "images": ["8", 0], "sd_version": "SDXL", "sub_batch_size": 16}},
  "10": {"class_type": "SaveImage", "_meta": {"title": "save rgb"},
        "inputs": {"images": ["9", 0], "filename_prefix": "flyover/sprite-rgb"}},
  "11": {"class_type": "MaskToImage", "_meta": {"title": "alpha"},
        "inputs": {"mask": ["9", 1]}},
  "12": {"class_type": "SaveImage", "_meta": {"title": "save alpha"},
        "inputs": {"images": ["11", 0], "filename_prefix": "flyover/sprite-alpha"}}
}
