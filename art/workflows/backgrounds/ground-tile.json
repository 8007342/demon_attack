{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "checkpoint"},
        "inputs": {"ckpt_name": "sdxl-full/sd_xl_base_1.0.safetensors"}},
  "2": {"class_type": "LoraLoader", "_meta": {"title": "pixel-art-xl"},
        "inputs": {"model": ["1", 0], "clip": ["1", 1], "lora_name": "pixel-art-xl.safetensors",
                   "strength_model": 1.0, "strength_clip": 1.0}},
  "3": {"class_type": "CLIPTextEncode", "_meta": {"title": "$prompt"},
        "inputs": {"clip": ["2", 1], "text": "pixel art ground texture"}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "$negative_prompt"},
        "inputs": {"clip": ["2", 1], "text": "text, watermark"}},
  "10": {"class_type": "LoadImage", "_meta": {"title": "layout"},
         "inputs": {"image": "$init_image"}},
  "11": {"class_type": "VAEEncode", "_meta": {"title": "encode layout"},
         "inputs": {"pixels": ["10", 0], "vae": ["1", 2]}},
  "12": {"class_type": "KSampler", "_meta": {"title": "$strength"},
         "inputs": {"model": ["2", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["11", 0],
                    "seed": 1, "steps": 30, "cfg": 6.5, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.8}},
  "13": {"class_type": "VAEDecode", "_meta": {"title": "decode pass 1"},
         "inputs": {"samples": ["12", 0], "vae": ["1", 2]}},
  "14": {"class_type": "ImageCrop", "_meta": {"title": "top half"},
         "inputs": {"image": ["13", 0], "width": 1536, "height": 768, "x": 0, "y": 0}},
  "15": {"class_type": "ImageCrop", "_meta": {"title": "bottom half"},
         "inputs": {"image": ["13", 0], "width": 1536, "height": 768, "x": 0, "y": 768}},
  "16": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll v: bottom to top"},
         "inputs": {"destination": ["13", 0], "source": ["15", 0], "x": 0, "y": 0, "resize_source": false}},
  "17": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll v: top to bottom"},
         "inputs": {"destination": ["16", 0], "source": ["14", 0], "x": 0, "y": 768, "resize_source": false}},
  "18": {"class_type": "LoadImage", "_meta": {"title": "horizontal seam band"},
         "inputs": {"image": "$mask"}},
  "19": {"class_type": "ImageToMask", "_meta": {"title": "h seam mask"},
         "inputs": {"image": ["18", 0], "channel": "red"}},
  "20": {"class_type": "VAEEncode", "_meta": {"title": "encode v-rolled"},
         "inputs": {"pixels": ["17", 0], "vae": ["1", 2]}},
  "21": {"class_type": "SetLatentNoiseMask", "_meta": {"title": "h seam only"},
         "inputs": {"samples": ["20", 0], "mask": ["19", 0]}},
  "22": {"class_type": "KSampler", "_meta": {"title": "h seam repaint"},
         "inputs": {"model": ["2", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["21", 0],
                    "seed": 2, "steps": 30, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.62}},
  "23": {"class_type": "VAEDecode", "_meta": {"title": "decode v-seamless"},
         "inputs": {"samples": ["22", 0], "vae": ["1", 2]}},
  "24": {"class_type": "ImageCrop", "_meta": {"title": "left half"},
         "inputs": {"image": ["23", 0], "width": 768, "height": 1536, "x": 0, "y": 0}},
  "25": {"class_type": "ImageCrop", "_meta": {"title": "right half"},
         "inputs": {"image": ["23", 0], "width": 768, "height": 1536, "x": 768, "y": 0}},
  "26": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll h: right to left"},
         "inputs": {"destination": ["23", 0], "source": ["25", 0], "x": 0, "y": 0, "resize_source": false}},
  "27": {"class_type": "ImageCompositeMasked", "_meta": {"title": "roll h: left to right"},
         "inputs": {"destination": ["26", 0], "source": ["24", 0], "x": 768, "y": 0, "resize_source": false}},
  "28": {"class_type": "LoadImage", "_meta": {"title": "vertical seam band"},
         "inputs": {"image": "$mask_v"}},
  "29": {"class_type": "ImageToMask", "_meta": {"title": "v seam mask"},
         "inputs": {"image": ["28", 0], "channel": "red"}},
  "30": {"class_type": "VAEEncode", "_meta": {"title": "encode h-rolled"},
         "inputs": {"pixels": ["27", 0], "vae": ["1", 2]}},
  "31": {"class_type": "SetLatentNoiseMask", "_meta": {"title": "v seam only"},
         "inputs": {"samples": ["30", 0], "mask": ["29", 0]}},
  "32": {"class_type": "KSampler", "_meta": {"title": "v seam repaint"},
         "inputs": {"model": ["2", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["31", 0],
                    "seed": 3, "steps": 30, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.62}},
  "33": {"class_type": "VAEDecode", "_meta": {"title": "decode seamless both ways"},
         "inputs": {"samples": ["32", 0], "vae": ["1", 2]}},
  "34": {"class_type": "SaveImage", "_meta": {"title": "save (rolled by half in x and y)"},
         "inputs": {"images": ["33", 0], "filename_prefix": "flyover/ground-tile"}}
}
