               {"text": "I mean, for duty!", "emotion": "calm", "intensity": 1, "direction": "flustered, correcting himself"}]},
    {"id": "P6", "ref": "bossDefeated.h3", "speaker": "sparrow", "text": "[whoop] Carrier down! Woohoo!", "emotion": "cheering", "intensity": 3},
    {"id": "P7", "ref": "broodTaunt.h0", "speaker": "admiral", "text": "Keep talking. We can play this all afternoon.", "emotion": "stern", "intensity": 1, "direction": "dry, unimpressed"},
