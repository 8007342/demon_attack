               {"text": "Thanks, friend!", "emotion": "warm", "intensity": 2}]},
    {"id": "P5", "ref": "sectorStart.h4", "speaker": "pip", "text": "Cadet Pip, reporting for awesome! I mean, for duty!", "emotion": "calm", "intensity": 1, "signature": true,
