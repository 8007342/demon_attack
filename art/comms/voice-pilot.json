      {"speaker": "kessler", "text": "Rocking... rocking... [whoop] We're loose! Sweet thrusters!", "emotion": "cheering", "intensity": 3, "gap": -0.2,
       "beats": [{"text": "Rocking... rocking...", "emotion": "exhausted", "intensity": 1},
