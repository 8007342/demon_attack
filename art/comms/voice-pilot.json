     "beats": [{"text": "Ha! Did you see that?", "emotion": "triumphant", "intensity": 2},
               {"text": "Textbook.", "emotion": "smug", "intensity": 2}]},
    {"id": "P4", "ref": "allySaved.h7", "speaker": "kessler", "text": "Whew. That was close. Thanks, friend!", "emotion": "warm", "intensity": 2,
