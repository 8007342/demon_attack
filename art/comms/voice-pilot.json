      {"speaker": "pip", "text": "[gasp] Missed me? It missed me! Woo!", "emotion": "cheering", "intensity": 3, "gap": 0.4,
       "beats": [{"text": "Missed me?", "emotion": "awed", "intensity": 1},
                 {"text": "It missed me! Woo!", "emotion": "cheering", "intensity": 3}]}
    ]}
