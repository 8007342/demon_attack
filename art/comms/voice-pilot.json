  "lines": [
    {"id": "P1", "ref": "sentinelDive.h3", "speaker": "rook", "text": "Incoming! Dodge, dodge, dodge!", "emotion": "panicked", "intensity": 3},
    {"id": "P2", "ref": "defeat.h0", "speaker": "admiral", "text": "All ships totalled, but every pilot is safe. Regroup at base. We go again.", "emotion": "warm", "intensity": 2,
