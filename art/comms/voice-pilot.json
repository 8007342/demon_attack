      {"speaker": "admiral", "text": "Settle down, squadron. ...Okay. One cheer.", "emotion": "warm", "intensity": 2, "gap": 0.3,
       "beats": [{"text": "Settle down, squadron.", "emotion": "stern", "intensity": 1},
                 {"text": "...Okay. One cheer.", "emotion": "warm", "intensity": 2, "direction": "giving in, smiling"}]}
    ]},
