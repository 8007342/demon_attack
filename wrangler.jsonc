{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demon-attack",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "demonattack.tlatoani.net", "custom_domain": true }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  }
}
